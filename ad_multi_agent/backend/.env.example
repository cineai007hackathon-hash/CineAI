# =============================================================================
# Film AD Multi-Agent System – Environment Variables
# Copy to .env and fill in values. Vertex AI ADC is preferred for local ADK web.
# =============================================================================

# PostgreSQL (local Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=film_ad
POSTGRES_USER=film_ad_user
POSTGRES_PASSWORD=film_ad_pass

# Gemini via Vertex AI
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_LOCATION=global
MODEL_NAME=gemini-2.5-flash

# Optional API-key path (leave blank when using Vertex ADC)
# GOOGLE_API_KEY=

LOG_LEVEL=INFO

# Feature toggles — DB tools are the source of truth for Phase 1
USE_LIVE_WEATHER_MCP=false
USE_LIVE_LOCATION_MCP=false
USE_DOCLING_MCP=false
USE_WATSONX_RAG=false
ENABLE_REPLAN_ON_FAILURE=true
