# =============================================================================
# Film AD Multi-Agent System – Environment Variables
# Copy to .env and fill in the values you need
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (Docker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=film_ad
POSTGRES_USER=film_ad_user
POSTGRES_PASSWORD=film_ad_pass

# Core / Runtime
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_gemini_api_key_here          # or use Vertex AI ADC
GOOGLE_GENAI_USE_VERTEXAI=false
MODEL_NAME=gemini-2.5-flash
LOG_LEVEL=INFO

# Path to the production dataset (used by tools/data_tools.py)
FILM_AD_DATA_PATH=./db/film_ad_dataset_v4.xlsx

# -----------------------------------------------------------------------------
# Optional – IBM Docling MCP (document understanding for root agent)
# -----------------------------------------------------------------------------
# Leave blank to run pure local Docling via uvx
DOCLING_SERVICE_URL= 
DOCLING_SERVICE_API_KEY= 
DOCLING_CONVERSION_MODE=local                    # local | remote
DOCLING_FALLBACK_TO_LOCAL=true

# -----------------------------------------------------------------------------
# Optional – IBM watsonx.data Document Library Retrieval MCP (RAG)
# Only needed if you want managed RAG over production documents
# -----------------------------------------------------------------------------
WATSONX_DATA_API_KEY= 
WATSONX_DATA_RETRIEVAL_ENDPOINT=https://console-ibm-xxx.lakehouse.saas.ibm.com
DOCUMENT_LIBRARY_API_ENDPOINT=https://api.xx-xx.dai.cloud.ibm.com
WATSONX_DATA_TOKEN_GENERATION_ENDPOINT=https://iam.cloud.ibm.com
LH_CONTEXT=SAAS

# -----------------------------------------------------------------------------
# Optional – External open-source Weather MCP (Open-Meteo – no key needed)
# Used only if you want live weather instead of the dataset readings
# -----------------------------------------------------------------------------
# No keys required for Open-Meteo based servers

# -----------------------------------------------------------------------------
# Optional – External Location / Geocoding MCP (OpenStreetMap – no key)
# -----------------------------------------------------------------------------
# No keys required

# -----------------------------------------------------------------------------
# Agent behaviour toggles
# -----------------------------------------------------------------------------
USE_LIVE_WEATHER_MCP=false                       # true → call external weather MCP
USE_LIVE_LOCATION_MCP=false                      # true → call external geocode MCP
USE_DOCLING_MCP=true                             # enable Docling for root agent
USE_WATSONX_RAG=false                            # enable watsonx Document Library